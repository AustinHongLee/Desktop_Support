{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "桌面輔助系統",
  "version": "0.1.0",
  "identifier": "com.austinhonglee.desktop-support.spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "桌面輔助工具列",
        "width": 28,
        "height": 168,
        "minWidth": 28,
        "minHeight": 120,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [],
    "externalBin": [
      "binaries/desktop-support-backend"
    ]
  }
}
